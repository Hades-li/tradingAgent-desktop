{
  "name": "tradingagents-desktop",
  "version": "0.2.0",
  "description": "Desktop client for TradingAgents",
  "author": "Tauric Research",
  "homepage": "https://github.com/TauricResearch/TradingAgents",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "electron scripts/generate-icons.mjs",
    "pack:mac": "pnpm run build && electron-builder --mac --dir",
    "dist:mac": "pnpm run build && electron-builder --mac --publish never",
    "dist:win": "pnpm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "i18next": "26.4.4",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.16",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
